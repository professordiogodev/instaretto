# Copy this file to .env and fill in real values. .env is gitignored.

# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# --- Database ---
# Local (docker-compose): postgresql://instaretto:instaretto@db:5432/instaretto
# RDS (Part 6 of the lab): postgresql://instaretto:<password>@<rds-endpoint>:5432/instaretto
DATABASE_URL=postgresql://instaretto:instaretto@db:5432/instaretto

# --- S3 ---
S3_BUCKET_UPLOADS=instaretto-uploads-<yourname>
S3_BUCKET_LOGS=instaretto-logs-<yourname>
AWS_REGION=us-east-1

# AWS credentials are NOT set here. Locally, boto3 picks up your AWS CLI
# profile (via ~/.aws/credentials, mounted read-only into the container).
# Set AWS_PROFILE to the least-privilege profile you create in LAB.md
# Part 2.2 -- don't run the app under your broad, account-owner profile.
# AWS_PROFILE=instaretto-local

# --- Logging ---
# Directory the app writes app.log / app.log.YYYY-MM-DD into.
# In docker-compose this is a mounted volume; on EC2, a host directory.
LOG_DIR=/var/log/instaretto
