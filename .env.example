# Copy this file to .env and fill in real values. .env is gitignored.

# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Local (Part 1): postgresql://instaretto:instaretto@localhost:5432/instaretto
# RDS (Part 6): postgresql://instaretto:<password>@<rds-endpoint>:5432/instaretto
DATABASE_URL=postgresql://instaretto:instaretto@localhost:5432/instaretto

# --- S3 ---
S3_BUCKET_UPLOADS=instaretto-uploads-<yourname>
S3_BUCKET_LOGS=instaretto-logs-<yourname>
AWS_REGION=us-east-1

# AWS credentials are NOT set here. Locally, boto3 picks up your AWS CLI
# profile (~/.aws/credentials). Set AWS_PROFILE if you use a named
# profile instead of "default".
# AWS_PROFILE=default

# --- Logging ---
# Directory the app writes app.log / app.log.YYYY-MM-DD into, relative
# to wherever you run the app from.
LOG_DIR=./data/logs
